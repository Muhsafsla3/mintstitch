# MintStitch — contoh konfigurasi (JANGAN isi nilai asli di sini)
# Salin ke .env lalu isi. File .env TIDAK BOLEH di-commit.

# Port server (default 3000)
PORT=3000

# Interval poll status mint, milidetik (default 60000)
POLL_INTERVAL_MS=60000

# Telegram (OPSIONAL — app tetap jalan tanpa ini).
# Buat bot via @BotFather, ambil chat id via @userinfobot atau getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
